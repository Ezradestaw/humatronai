# ==============================================================================
# Humatron Bot & Companion Service Environment Configuration
# Copy this file to .env and populate with your production values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_botfather_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321
# Optional Proxy for regions where api.telegram.org is restricted (e.g., socks5://127.0.0.1:1080)
TELEGRAM_PROXY=

# Humatron Core Service Settings
ENVIRONMENT=development
HUMATRON_API_BASE_URL=https://humatron.me
HUMATRON_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 18 Async connection string)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/humatron_db

# Webhook Configuration (For Production)
USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=https://humatron.me/api/telegram-webhook
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_token

# File Upload & PDF Processing Constraints
MAX_PDF_SIZE_MB=20
MAX_PDF_PAGES=300
TEMP_UPLOAD_DIR=temp_uploads

# Payment Gateways (Optional / Sandbox defaults)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
