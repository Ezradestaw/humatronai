# ==============================================================================
# Humatron Bot & Companion Service Environment Configuration
# ==============================================================================

# 1. Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=8920812675:AAGjTm-qGsv2OtJ_V0-fHHUjcLd4mt8WVa0

# 2. Admin Telegram User IDs (comma-separated numbers)
# Open @userinfobot on Telegram to get your numeric ID
ADMIN_TELEGRAM_IDS=your_telegram_id_here

# 3. Environment
ENVIRONMENT=production
HUMATRON_API_BASE_URL=https://humatron.me
HUMATRON_SECRET_KEY=94e77248f278bfa79f64c63de0d0144fbb7aef6494747c344400a4ce5757d549
HOST=0.0.0.0
PORT=8000

# 4. Database Configuration
# On Render: Render provides this automatically from the PostgreSQL database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/humatron_db

# 5. Polling vs Webhook
# Keep false on Render (runs automatically in background)
USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# 6. Optional Proxy (Only for local development in Ethiopia without VPN; leave blank on Render)
TELEGRAM_PROXY=

# 7. Document Limits
MAX_PDF_SIZE_MB=20
MAX_PDF_PAGES=300
TEMP_UPLOAD_DIR=temp_uploads

# 8. Payment System: Binance Pay (Manual Approval)
# Payments use the bundled Binance QR code (recipient: Burton Knick rZXe).
